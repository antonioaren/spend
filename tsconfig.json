{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
